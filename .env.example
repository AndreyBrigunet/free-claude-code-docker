# Docker image produced by GitHub Actions.
FCC_IMAGE=ghcr.io/andreybrigunet/free-claude-code-docker:latest

# Keep FCC local by default. Put Caddy/Nginx/Cloudflare Tunnel in front of it
# when external applications such as a Cloudflare Worker need HTTPS access.
FCC_BIND_ADDRESS=127.0.0.1
FCC_PORT=8082

# REQUIRED. Generate a long random value, for example:
# openssl rand -hex 32
FCC_AUTH_TOKEN=replace-with-a-long-random-secret

# Persistent Docker volume containing FCC configuration, connected accounts and logs.
FCC_DATA_VOLUME=fcc-data

LOG_LEVEL=INFO
