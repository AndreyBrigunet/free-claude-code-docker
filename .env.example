FCC_IMAGE=ghcr.io/andreybrigunet/free-claude-code-docker:latest

FCC_AUTH_TOKEN=replace-with-a-long-random-secret
FCC_DATA_VOLUME=fcc-data

LOG_LEVEL=INFO

# Traefik
TRAEFIK_IMAGE=traefik:v3.7
TRAEFIK_DOMAIN=fcc.example.com
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_DATA_VOLUME=traefik-letsencrypt

# BasicAuth for /admin.
# Generate with:
# docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password'
#
# Put the complete result here in single quotes.
TRAEFIK_ADMIN_USERS='admin:$2y$05$replace-with-generated-hash'
